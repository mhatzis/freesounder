# FreeSounder A/B SD card layout (MiB). Changing this needs a re-flash of every player: don't.
# MBR (Pi 3 / Zero 2 W boot ROMs can't read GPT), fixed disk id so PARTUUIDs are stable everywhere.
FS_DISK_ID=0x46534f54
FS_ALIGN_MIB=8
FS_BOOTSEL_MIB=64      # p1  FAT16 autoboot.txt (+ bootcode.bin, empty config.txt for Pi 3 / Zero 2 W)
FS_BOOT_MIB=256        # p2/p3 FAT32 per-slot firmware + kernel (Pi OS uses ~90 MiB today)
FS_ROOT_MIB=4096       # p5/p6 ext4 root A/B (2.3 GiB used in 0.6.16)
FS_DATA_MIN_MIB=512    # p7 ext4 data: created on first boot from the rest of the card
FS_EBR_GAP_MIB=8       # room for each logical partition's EBR, keeps alignment
