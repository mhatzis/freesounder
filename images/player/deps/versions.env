# AirPlay 2: shairport-sync 5.6.2 + nqptp 1.2.9 rebuilt from Debian sid for
# trixie by .github/workflows/deps-airplay2.yml (artifact airplay2-trixie-arm64).
# Put the .debs in images/player/.cache/deps/airplay2/ (fetch.sh does it with
# gh when AIRPLAY2_RUN_ID is set). Without them the image falls back to
# trixie's shairport-sync 4.3.7 (AirPlay 1 only).
# UPnP/DLNA + OpenHome renderer: upmpdcli from its author's Raspberry Pi OS /
# Debian trixie repository (https://www.lesbonscomptes.com/upmpdcli/, key
# F8E3347256922A8AE767605B7808CE96D38B9201; hashes from its signed InRelease).
UPMPDCLI_BASE=https://www.lesbonscomptes.com/upmpdcli/downloads/raspbian
UPMPDCLI_DEB=upmpdcli_1.10.1-1~ppa1~trixie_arm64.deb
UPMPDCLI_PATH=pool/main/u/upmpdcli
UPMPDCLI_SHA256=19a91729ae023a8591c29648e5592cf8e51e5e1f117b967c951f32cc79514846
