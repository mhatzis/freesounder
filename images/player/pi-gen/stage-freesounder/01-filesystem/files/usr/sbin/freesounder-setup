#!/bin/bash
# Local helper for a FreeSounder v2 player (console / developer SSH).
set -euo pipefail

usage() {
	cat << 'HELP'
freesounder-setup - inspect or configure this player

Usage:
  freesounder-setup status              # room, household, group, sources
  freesounder-setup doctor              # BLE / network / services diagnostics
  freesounder-setup audio               # output device, EQ chain, snapclient and stream state
  freesounder-setup test-tone           # play left / right / both tones on this speaker
  freesounder-setup set-name <room>     # rename the room (also fs-<room> hostname)
  freesounder-setup set-dac auto|none|dacplus|digiampplus|hifiberry-dac|iqaudio-dacplus
  freesounder-setup reset               # forget the household and room (factory reset)

Every player is equal. Use the FreeSounder app for everything else.
HELP
}

need_root() {
	if [[ "$(id -u)" -ne 0 ]]; then
		echo "Run as root (sudo freesounder-setup ...)" >&2
		exit 1
	fi
}

api() {
	curl -fsS --max-time 15 -H 'Content-Type: application/json' "$@"
}

cmd=${1:-help}
case "$cmd" in
	status)
		cat /run/freesounder/status.json 2>/dev/null || echo "freesounderd has not written a status yet"
		cat /etc/freesounder/features.json 2>/dev/null || true
		;;
	doctor)
		if [[ -x /opt/freesounder/venv/bin/freesounder-ble-provisioning ]]; then
			/opt/freesounder/venv/bin/freesounder-ble-provisioning --doctor || true
		fi
		api http://127.0.0.1:8080/api/v2/doctor || true
		echo
		;;
	audio)
		cat /etc/freesounder/audio-output 2>/dev/null || echo "no output chosen yet"
		id=$(cat /etc/freesounder/player-id 2>/dev/null || true)
		if [[ -n "$id" ]]; then
			api "http://127.0.0.1:8080/api/v2/rooms/${id}/audio" || true
			echo
		fi
		echo "snapclient: $(systemctl is-active snapclient.service 2>/dev/null)"
		cat /run/freesounder/snapclient.env 2>/dev/null | grep -v '^FS_PLAYER_ID' || true
		for f in /proc/asound/card*/pcm*p/sub0/status; do
			[[ -r "$f" ]] && echo "$f: $(head -1 "$f")"
		done
		;;
	test-tone)
		need_root
		id=$(cat /etc/freesounder/player-id 2>/dev/null || true)
		echo "Playing: left 440 Hz, right 660 Hz, then both 880 Hz..."
		if [[ -n "$id" ]] && api --max-time 45 -X POST "http://127.0.0.1:8080/api/v2/rooms/${id}/test-tone" -d '{}'; then
			echo
		else
			# freesounderd is not answering: do it by hand.
			systemctl stop snapclient.service || true
			/usr/lib/freesounder/select-audio-output || true
			speaker-test -D freesounder -c 2 -t sine -f 440 -l 1 -p 1000000 || echo "speaker-test failed (see the error above)"
			systemctl start snapclient.service || true
		fi
		;;
	set-name)
		need_root
		[[ $# -ge 2 ]] || { usage; exit 1; }
		id=$(cat /etc/freesounder/player-id)
		name=$(python3 -c 'import json,sys; print(json.dumps({"name": sys.argv[1]}))' "$2")
		api -X PATCH "http://127.0.0.1:8080/api/v2/rooms/${id}/settings" -d "$name"
		echo
		;;
	set-dac)
		need_root
		[[ $# -ge 2 ]] || { usage; exit 1; }
		id=$(cat /etc/freesounder/player-id)
		api -X PATCH "http://127.0.0.1:8080/api/v2/rooms/${id}/settings" -d "{\"dac\": \"$2\"}"
		echo
		echo "Reboot to load a new DAC overlay."
		;;
	reset)
		need_root
		api -X POST http://127.0.0.1:8080/api/v2/reset -d '{"confirm": true}'
		rm -rf /var/lib/freesounder/spotify/* 2>/dev/null || true
		echo
		;;
	help|-h|--help) usage ;;
	*) usage; exit 1 ;;
esac
