#!/bin/bash
# Resolve /etc/freesounder/role (host|room|auto) to an effective role.
# auto: host if MemTotal >= 3.5 GiB, otherwise room.
set -euo pipefail
ROLE_FILE=/etc/freesounder/role
EFFECTIVE=/run/freesounder/effective-role
mkdir -p /run/freesounder
role=auto
if [[ -f "$ROLE_FILE" ]]; then
	role=$(tr -d '[:space:]' < "$ROLE_FILE")
fi
case "$role" in
	host|room) effective="$role" ;;
	auto|"")
		mem_kb=$(awk '/MemTotal:/ {print $2}' /proc/meminfo)
		# 3.5 GiB = 3.5 * 1024 * 1024 KiB
		if [[ "${mem_kb:-0}" -ge 3670016 ]]; then
			effective=host
		else
			effective=room
		fi
		;;
	*)
		echo "Unknown role '$role' in $ROLE_FILE (expected host, room, or auto)" >&2
		effective=room
		;;
esac
printf '%s\n' "$effective" > "$EFFECTIVE"
cat "$EFFECTIVE"
