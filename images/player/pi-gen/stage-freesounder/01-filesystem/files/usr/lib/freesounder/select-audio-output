#!/bin/bash
# Pick the ALSA device the `freesounder` chain plays to, so snapclient can
# always open a device:
#   1. a DAC/HAT or USB card (anything that is not vc4-hdmi),
#   2. the HDMI port with a display connected (Pi 5: vc4hdmi0 = HDMI0,
#      vc4hdmi1 = HDMI1; there is no analog jack),
#   3. the Pi 4 headphone jack,
#   4. otherwise the null sink (silent, but the room still appears).
# Early in boot it waits up to 20 s for the cards (and for the DAC board when
# one is expected), so it does not settle on the null sink while they probe.
# HDMI uses the `hdmi:` PCM (IEC958 subframes; vc4-hdmi-0 and vc4-hdmi-1 are
# separate cards), never `default:`, whose softvol control can sit at 0.
# Cards use `hw:CARD=<id>,DEV=0` under our own plug: `default:CARD=` adds a
# second plug, and that stack fails hw-params on a PCM5122 DAC
# (snd_interval_empty assertion). After rendering, a 1 s silent write checks
# the chain (check=ok or the exact aplay error); if only a plain plug opens,
# direct=1 (no tone controls).
# Writes /etc/freesounder/audio-output (pcm=, card=, kind=, reason=), unmutes
# the card's mixer, and re-renders /etc/alsa/conf.d/99-freesounder.conf (with a
# self-test). Run before snapclient starts and on HDMI hotplug.
set -uo pipefail

OUT=/etc/freesounder/audio-output
CARDS=${FREESOUNDER_ASOUND_CARDS:-/proc/asound/cards}
DRM=${FREESOUNDER_DRM_DIR:-/sys/class/drm}

pcm=null
card=0
kind=null
reason="no audio device found; using the null sink so the room still registers"

DETECT=${FREESOUNDER_AUDIO_DETECT:-/run/freesounder/audio-detect.json}
BOOT_CFG=${FREESOUNDER_BOOT_CONFIG:-/boot/firmware/config.txt}
UPTIME=${FREESOUNDER_UPTIME:-$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 999)}
WAIT=${FREESOUNDER_CARD_WAIT:-20}

declare -a ids=()
card_re='^([0-9]+) \[([A-Za-z0-9_]+) *\]: ([^ ]+)'
read_cards() {
	ids=()
	while read -r line; do
		if [[ "$line" =~ $card_re ]]; then
			ids+=("${BASH_REMATCH[1]}:${BASH_REMATCH[2]}:${BASH_REMATCH[3]}")
		fi
	done < "$CARDS" 2>/dev/null
}
has_external() {
	local entry index id driver
	for entry in "${ids[@]}"; do
		IFS=: read -r index id driver <<<"$entry"
		if [[ "$driver" != "vc4-hdmi" && "$id" != vc4hdmi* && "$id" != Headphones ]]; then
			return 0
		fi
	done
	return 1
}
# A DAC/amp board is expected when the boot detection found one or an
# overlay is set in config.txt (or a HAT EEPROM is present).
expect_external() {
	grep -q '"expect_card": true' "$DETECT" 2>/dev/null && return 0
	[[ -e /proc/device-tree/hat/product && -z "${FREESOUNDER_ASOUND_CARDS:-}" ]] && return 0
	sed -n '/^# --- freesounder-dac-start ---$/,/^# --- freesounder-dac-end ---$/p' "$BOOT_CFG" 2>/dev/null |
		grep -q '^dtoverlay='
}
read_cards
# Early in boot the cards may still be probing (I2C codecs, vc4 HDMI,
# USB): wait for them instead of settling on the null sink.
if (( UPTIME < 180 )); then
	waited=0
	while (( waited < WAIT )); do
		if (( ${#ids[@]} > 0 )) && { has_external || ! expect_external; }; then
			break
		fi
		sleep 1
		waited=$((waited + 1))
		read_cards
	done
fi
cards_seen=$(cat "$CARDS" 2>/dev/null | md5sum)
card_list=""
for entry in "${ids[@]}"; do
	IFS=: read -r _ id _ <<<"$entry"
	card_list+="${card_list:+, }$id"
done
if (( ${#ids[@]} == 0 )); then
	reason="no sound card found (the kernel listed none); using the null sink so the room still registers"
else
	reason="no DAC/USB card, no HDMI display and no headphone jack; using the null sink so the room still registers"
fi
detected=$(sed -n 's/.*"detected": "\(.*\)",$/\1/p' "$DETECT" 2>/dev/null | head -1)

hdmi_connected() {
	# vc4hdmi0 -> HDMI-A-1, vc4hdmi1 -> HDMI-A-2
	local n=$1 status
	for status in "$DRM"/card*-HDMI-A-$((n + 1))/status; do
		[[ -r "$status" ]] && [[ "$(cat "$status")" == "connected" ]] && return 0
	done
	return 1
}

chosen=""
for entry in "${ids[@]}"; do
	IFS=: read -r index id driver <<<"$entry"
	if [[ "$driver" != "vc4-hdmi" && "$id" != vc4hdmi* && "$id" != Headphones ]]; then
		chosen="$index:$id"
		kind=card
		reason="sound card $id"
		break
	fi
done
if [[ -z "$chosen" ]]; then
	for entry in "${ids[@]}"; do
		IFS=: read -r index id driver <<<"$entry"
		if [[ "$id" =~ ^vc4hdmi([0-9]+)$ ]] && hdmi_connected "${BASH_REMATCH[1]}"; then
			chosen="$index:$id"
			kind=hdmi
			reason="HDMI$((BASH_REMATCH[1])) (display connected)"
			break
		fi
	done
fi
if [[ -z "$chosen" ]]; then
	for entry in "${ids[@]}"; do
		IFS=: read -r index id driver <<<"$entry"
		if [[ "$id" == Headphones ]]; then
			chosen="$index:$id"
			kind=analog
			reason="headphone jack (no HDMI display connected)"
			break
		fi
	done
fi
if [[ -n "$chosen" ]]; then
	IFS=: read -r index id <<<"$chosen"
	if [[ $kind == hdmi ]]; then
		pcm="hdmi:CARD=$id,DEV=0"
	else
		pcm="hw:CARD=$id,DEV=0"
	fi
	card=$index
fi

# Hardware mixer at 0 dB and unmuted: snapclient does the volume in software,
# so a muted or zero card control means silence while the app says playing.
unmute_card() {
	local c=$1 control
	command -v amixer >/dev/null 2>&1 || return 0
	while IFS= read -r control; do
		control=${control#Simple mixer control }
		# Only playback level/mute controls. Codec tuning knobs must keep their
		# defaults: on a PCM512x "100%" means Max Overclock PLL/DAC/DSP at the
		# limit, the longest Clock Missing Period and Volume Ramp, and "unmute"
		# switches Auto Mute *on*.
		case "$control" in
			*Capture*|*Mic*|*Boost*|*Overclock*|*Ramp*|*"Auto Mute"*|*Clock*|*Deemphasis*|*Program*|*Mode*|*Filter*) continue ;;
		esac
		amixer -q -c "$c" sset "$control" 0dB unmute 2>/dev/null ||
			amixer -q -c "$c" sset "$control" 100% unmute 2>/dev/null ||
			amixer -q -c "$c" sset "$control" unmute 2>/dev/null || true
	done < <(amixer -c "$c" scontrols 2>/dev/null)
}
if [[ $kind != null && -z "${FREESOUNDER_NO_RENDER:-}" ]]; then
	unmute_card "$card"
fi

old_out=$(cat "$OUT" 2>/dev/null)
write_output() {
	new=$(printf 'pcm=%s\ncard=%s\nkind=%s\nreason=%s\ncards=%s\ndetected=%s%s' \
		"$pcm" "$card" "$kind" "$reason" "${card_list:-none}" "${detected:-}" "$1")
	if [[ "$(cat "$OUT" 2>/dev/null)" != "$new" ]]; then
		install -d "$(dirname "$OUT")"
		printf '%s\n' "$new" > "$OUT"
	fi
}
render() {
	if [[ -z "${FREESOUNDER_NO_RENDER:-}" ]]; then
		/usr/lib/freesounder/apply-dsp-config || echo "apply-dsp-config failed" >&2
	fi
}
# 1 s of silence through a PCM; the last aplay line on failure.
probe_err=""
probe() {
	if [[ -n "${FREESOUNDER_PROBE_RESULT:-}" ]]; then
		probe_err=${FREESOUNDER_PROBE_RESULT#fail:}
		[[ "$FREESOUNDER_PROBE_RESULT" == ok ]]
		return
	fi
	[[ -n "${FREESOUNDER_NO_RENDER:-}" ]] && return 0
	command -v aplay >/dev/null 2>&1 || return 0
	probe_err=$(timeout 12 aplay -q -D "$1" -t raw -f S16_LE -r 44100 -c 2 -d 1 /dev/zero 2>&1 >/dev/null)
	local rc=$?
	probe_err=$(printf '%s' "$probe_err" | tail -1)
	(( rc == 124 )) && probe_err="aplay timed out on $1"
	return $rc
}
# The card's playback PCM is free (snapclient is not holding it).
pcm_free() {
	[[ -n "${FREESOUNDER_PROBE_RESULT:-}" ]] && return 0
	local status
	status=$(cat "/proc/asound/card$card/pcm0p/sub0/status" 2>/dev/null) || return 0
	[[ "$status" == closed ]]
}
check=""
last_check=$(sed -n 's/^check=//p' <<<"$old_out")
last_direct=$(sed -n 's/^direct=//p' <<<"$old_out")
same_pcm=0
[[ "$(sed -n 's/^pcm=//p' <<<"$old_out")" == "$pcm" && "$(sed -n 's/^cards=//p' <<<"$old_out")" == "${card_list:-none}" ]] && same_pcm=1
write_output ""
render
if [[ $kind != null && ! ( $same_pcm == 1 && $last_check == ok ) ]] && pcm_free; then
	if probe freesounder; then
		check=ok
	else
		first_err=$probe_err
		echo "full chain would not open on $pcm: $first_err" >&2
		write_output $'\n'"direct=1"
		render
		if probe freesounder; then
			check="full chain failed ($first_err); playing without tone controls"
			write_output $'\n'"check=$check"$'\n'"direct=1"
		else
			check="failed: ${probe_err:-$first_err}"
			echo "output $pcm would not open: $probe_err" >&2
			write_output $'\n'"check=$check"
			render
		fi
	fi
	[[ $check == ok ]] && write_output $'\n'"check=ok"
else
	# Already checked, in use (snapclient is playing on it), or the null
	# sink: keep the last check for the same device.
	if [[ $kind != null && -n "$last_check" && $same_pcm == 1 ]]; then
		extra=$'\n'"check=$last_check"
		[[ "$last_direct" == 1 ]] && extra+=$'\n'"direct=1"
		write_output "$extra"
		render
	fi
fi
changed=0
[[ "$(cat "$OUT" 2>/dev/null)" != "$old_out" ]] && changed=1
echo "freesounder audio output: $pcm ($reason)${check:+; check: $check}"
# Hotplug (udev): only bounce snapclient when the device actually changed.
if [[ "${1:-}" == "--restart-if-changed" && $changed == 1 ]]; then
	systemctl --no-block try-restart snapclient.service || true
fi
# A card that appeared while this ran would be missed (a second udev start
# of the oneshot merges into the running one): look again.
if [[ "$(cat "$CARDS" 2>/dev/null | md5sum)" != "$cards_seen" && "${FS_SAO_PASS:-0}" -lt 3 ]]; then
	FS_SAO_PASS=$(( ${FS_SAO_PASS:-0} + 1 )) exec "$0" --restart-if-changed
fi
