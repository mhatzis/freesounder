#!/bin/bash
# HDMI status screen on tty1. No login prompt; refreshes every few seconds.
set +e
exec >/dev/tty1 2>&1
printf '\033[?25l' 2>/dev/null
trap 'printf "\033[?25h" 2>/dev/null' EXIT

ssh_state() {
	if [[ -f /run/freesounder/ssh-developer.json ]] && systemctl is-active --quiet ssh.service 2>/dev/null; then
		echo "developer mode (off after reboot)"
	else
		echo "disabled"
	fi
}

# Real uplink IPv4 only: never show docker0/veth/br-* or 169.254/127.
ips() {
	ip -4 -o addr show 2>/dev/null | awk '
		{
			iface=$2
			sub(/:$/, "", iface)
			split($4, a, "/")
			addr=a[1]
			if (iface == "lo" || iface ~ /^(docker|br-|veth|virbr|cni|flannel|lxc|tunl|sit|dummy|vmnet|kube)/) next
			if (iface == "docker0") next
			if (addr ~ /^127\./ || addr ~ /^169\.254\./) next
			print addr " (" iface ")"
		}
	' | paste -sd ", " -
}

room_name() {
	if [[ -f /etc/freesounder/name ]]; then
		tr -d '\n' </etc/freesounder/name
	fi
}

role() {
	# leader / member of <room>, from freesounderd's status file.
	python3 - <<'PY' 2>/dev/null || echo "?"
import json
try:
    st = json.load(open("/run/freesounder/status.json"))
except (OSError, ValueError):
    print("starting")
    raise SystemExit
role = st.get("role", "?")
if role == "member":
    role += f" of {st.get('leader') or '?'}"
print(f"{role} - {st.get('group', '?')}")
PY
}

ble_block() {
	PY=python3
	if [[ -x /opt/freesounder/venv/bin/python ]]; then
		PY=/opt/freesounder/venv/bin/python
	fi
	"$PY" - <<'PY'
import json
from pathlib import Path

status = {}
path = Path("/run/freesounder/ble-status.json")
try:
    status = json.loads(path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    status = {}

live = {}
try:
    from freesounder_ble_provisioning.status import read_live_adapter

    live = read_live_adapter()
except Exception:
    live = {}

hci = "missing"
hci0 = Path("/sys/class/bluetooth/hci0")
if hci0.is_dir() or live.get("adapter"):
    addr = live.get("address") or ""
    if not addr and hci0.is_dir():
        try:
            addr = (hci0 / "address").read_text(encoding="utf-8").strip()
        except OSError:
            pass
    hci = "present" + (f" {addr}" if addr else "")

powered = status.get("powered")
if powered is None:
    powered = live.get("powered")
pwr = {True: "yes", False: "no"}.get(powered, "?")

rfkill = status.get("rfkill") or "unknown"
advertising = status.get("advertising")
wanted = status.get("wanted")
online_reason = status.get("online_reason") or ""
register = status.get("register_result") or "no attempt yet"
last_error = status.get("last_error") or ""
last_at = status.get("last_error_at") or ""
scan = status.get("scan_response") or ""
primary = status.get("primary_pdu") or ""

adv = "yes" if advertising else "no"
if wanted is True and advertising:
    want = "advertise"
elif wanted is True:
    want = "advertise, but not on the air"
elif wanted is False:
    want = "quiet (LAN gateway)"
else:
    want = "unknown"

lines = [
    f"  wanted      : {want}",
    f"  advertising : {adv}",
    f"  hci0        : {hci}  Powered={pwr}",
    f"  rfkill      : {rfkill}",
    f"  register    : {register}",
]
if last_error:
    when = f" ({last_at})" if last_at else ""
    lines.append(f"  last error  : {last_error}{when}")
if online_reason:
    lines.append(f"  online check: {online_reason}")
if primary:
    lines.append(f"  primary PDU : {primary}")
if scan:
    lines.append(f"  scan resp   : {scan}")
print("\n".join(lines))
PY
}

wifi_block() {
	PY=python3
	if [[ -x /opt/freesounder/venv/bin/python ]]; then
		PY=/opt/freesounder/venv/bin/python
	fi
	"$PY" - <<'PY'
import json
from pathlib import Path

try:
    from freesounder_ble_provisioning.status import read_wifi_live, wifi_status_lines
except Exception as exc:
    print(f"  (Wi-Fi status unavailable: {exc})")
    raise SystemExit(0)
try:
    saved = json.loads(Path("/run/freesounder/wifi-status.json").read_text(encoding="utf-8"))
except (OSError, ValueError):
    saved = {}
try:
    print("\n".join(wifi_status_lines(read_wifi_live(), saved)))
except Exception as exc:
    print(f"  (Wi-Fi status failed: {exc})")
PY
}

services_block() {
	PY=python3
	if [[ -x /opt/freesounder/venv/bin/python ]]; then
		PY=/opt/freesounder/venv/bin/python
	fi
	"$PY" - <<'PY'
try:
    from freesounder_ble_provisioning.doctor import lan_ip
    from freesounder_ble_provisioning.status import read_services_live, services_status_lines
except Exception as exc:
    print(f"  (service status unavailable: {exc})")
    raise SystemExit(0)
try:
    print("\n".join(services_status_lines(read_services_live(), lan_ip())))
except Exception as exc:
    print(f"  (service status failed: {exc})")
PY
}

audio_block() {
	PY=python3
	if [[ -x /opt/freesounder/venv/bin/python ]]; then
		PY=/opt/freesounder/venv/bin/python
	fi
	SNAP=$(systemctl is-active snapclient.service 2>/dev/null)
	SNAP="$SNAP" "$PY" - <<'PY'
import json
import os
from pathlib import Path

out = {}
try:
    for line in Path("/etc/freesounder/audio-output").read_text().splitlines():
        k, _, v = line.partition("=")
        out[k] = v
except OSError:
    pass
try:
    st = json.loads(Path("/run/freesounder/status.json").read_text())
except (OSError, ValueError):
    st = {}
audio = st.get("audio") or {}
chain = audio.get("chain") or {}
hw = audio.get("hw") or {}
snap = audio.get("snapclient") or {}
stream = audio.get("stream") or {}
target = st.get("snapclient_target") or "?"
print(f"  output     : {out.get('pcm', 'not chosen yet')} - {out.get('reason', '')}")
dsp = chain.get("dsp", "?")
ok = chain.get("ok")
note = "" if ok in (None, True) else f"  FAILED: {chain.get('detail', '')}"
if chain.get("dsp_error"):
    note += f"  (tone controls off: {chain['dsp_error']})"
try:
    params = Path("/run/freesounder/dsp-params").read_text().split()[1:]
    note += "  bass/treble/bal/loud " + " ".join(params)
except OSError:
    pass
print(f"  ALSA chain : DSP {dsp}{note}")
if hw:
    fmt = " ".join(str(hw[k]) for k in ("format", "rate") if hw.get(k))
    print(f"  device     : {hw.get('device', '?')} {hw.get('state', '?')} {fmt}".rstrip())
vol = snap.get("volume")
mute = " MUTED" if snap.get("muted") else ""
conn = "connected" if snap.get("connected") else "not connected"
print(f"  snapclient : {os.environ.get('SNAP', '?')}, {conn} to {target}, volume {vol}{mute}")
src = st.get("source", "?")
radio = audio.get("radio")
extra = ""
if radio is not None:
    extra = "  decoder " + ("running" if radio.get("running") else "NOT running")
    if radio.get("restarts"):
        extra += f" (restarts {radio['restarts']})"
print(f"  stream     : {stream.get('id', '?')} {stream.get('status', '')} - source {src}, {st.get('play_state', '?')}{extra}")
PY
}

while true; do
	host=$(hostname -s 2>/dev/null || echo fs-new)
	pretty=$(room_name)
	addr=$(ips)
	[[ -n "$addr" ]] || addr="no network"
	clear 2>/dev/null
	printf '\033[H'
	cat <<STATUS
FreeSounder
-----------
Hostname : ${host}
Room     : ${pretty:-not set yet (use the app)}
Group    : $(role)
Address  : ${addr}
mDNS     : ${host}.local
SSH      : $(ssh_state)

BLE
$(ble_block)

Wi-Fi
$(wifi_block)

Audio
$(audio_block)

Services
$(services_block)

This player is a locked-down appliance.
There is no login on this screen (fsadmin is on tty2+).
Set it up in the FreeSounder app (Bluetooth or the local network).
Doctor report: /boot/firmware/freesounder-doctor.txt
STATUS
	sleep 5
done
