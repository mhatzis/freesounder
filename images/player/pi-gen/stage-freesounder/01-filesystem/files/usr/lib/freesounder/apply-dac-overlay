#!/bin/bash
# Set or clear the I2S DAC overlay in config.txt.
#   auto  : nothing forced. HATs with an ID EEPROM (official Raspberry Pi
#           DAC+/DigiAMP+, most HiFiBerry and IQaudio boards) are detected by
#           the firmware, which loads their overlay itself; select-audio-output
#           then prefers the HAT's sound card over HDMI.
#   none  : onboard / USB audio only.
#   Boards without an EEPROM (or to force one), choice -> dtoverlay:
#     dacplus              rpi-dacplus                 Raspberry Pi DAC+
#     digiampplus          rpi-digiampplus,unmute_amp  Raspberry Pi DigiAMP+
#     iqaudio-dacplus      iqaudio-dacplus             IQaudio DAC+ / DAC Zero
#     iqaudio-digiampplus  iqaudio-dacplus,unmute_amp  IQaudio DigiAMP+
#     hifiberry-dacplus    hifiberry-dacplus           HiFiBerry DAC+ / DAC2 Pro
#     hifiberry-amp2       hifiberry-dacplus           HiFiBerry Amp2
#     hifiberry-amp3       hifiberry-amp3              HiFiBerry Amp3
#     hifiberry-amp4       hifiberry-dacplus-std       HiFiBerry Amp4
#     hifiberry-amp4pro    hifiberry-amp4pro           HiFiBerry Amp4 Pro
#     hifiberry-amp100     hifiberry-amp100            HiFiBerry Amp100
#     hifiberry-dac        hifiberry-dac               PCM5102A boards (HiFiBerry DAC,
#                                                      Pimoroni pHAT DAC, generic)
#     pcm5122-amp          hifiberry-dacplus           PCM5122 amp HATs (Innomaker
#                                                      HiFi AMP, Waveshare, ...)
#     max98357a            max98357a,no-sdmode         MAX98357A I2S amps (Adafruit,
#                                                      Pimoroni Audio Amp SHIM, ...)
#     justboom-dac         justboom-dac                JustBoom DAC / Amp
#     wm8960               wm8960-soundcard            Waveshare WM8960 Audio HAT
set -euo pipefail
choice=${1:-$(tr -d '[:space:]' < /etc/freesounder/dac 2>/dev/null || echo auto)}
cfg=""
for candidate in /boot/firmware/config.txt /boot/config.txt; do
	if [[ -f "$candidate" ]]; then
		cfg=$candidate
		break
	fi
done
if [[ -z "$cfg" ]]; then
	echo "No config.txt found under /boot/firmware or /boot" >&2
	exit 1
fi

# Remove any previous freesounder-managed block.
python3 - "$cfg" << 'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
text = p.read_text()
start = "# --- freesounder-dac-start ---\n"
end = "# --- freesounder-dac-end ---\n"
if start in text and end in text:
    pre, rest = text.split(start, 1)
    _, post = rest.split(end, 1)
    text = pre + post
p.write_text(text)
PY

overlay=""
case "$choice" in
	auto|"")
		printf 'auto\n' > /etc/freesounder/dac
		echo "DAC: auto (EEPROM HATs load their own overlay)."
		exit 0
		;;
	none)
		printf 'none\n' > /etc/freesounder/dac
		echo "DAC overlay cleared (onboard / USB audio)."
		exit 0
		;;
	dacplus) overlay=rpi-dacplus ;;
	digiampplus) overlay=rpi-digiampplus,unmute_amp ;;
	iqaudio-dacplus) overlay=iqaudio-dacplus ;;
	iqaudio-digiampplus) overlay=iqaudio-dacplus,unmute_amp ;;
	hifiberry-dacplus|hifiberry-amp2|pcm5122-amp) overlay=hifiberry-dacplus ;;
	hifiberry-amp3) overlay=hifiberry-amp3 ;;
	hifiberry-amp4) overlay=hifiberry-dacplus-std ;;
	hifiberry-amp4pro) overlay=hifiberry-amp4pro ;;
	hifiberry-amp100) overlay=hifiberry-amp100 ;;
	hifiberry-dac) overlay=hifiberry-dac ;;
	max98357a) overlay=max98357a,no-sdmode ;;
	justboom-dac) overlay=justboom-dac ;;
	wm8960) overlay=wm8960-soundcard ;;
	*)
		echo "Unknown DAC '$choice' (see the list at the top of $0)" >&2
		exit 1
		;;
esac
{
	echo "# --- freesounder-dac-start ---"
	echo "# Set from the FreeSounder app (room sound settings: $choice)."
	echo "dtoverlay=$overlay"
	echo "# --- freesounder-dac-end ---"
} >> "$cfg"
printf '%s\n' "$choice" > /etc/freesounder/dac
echo "Wrote dtoverlay=$overlay to $cfg (reboot to apply)."
