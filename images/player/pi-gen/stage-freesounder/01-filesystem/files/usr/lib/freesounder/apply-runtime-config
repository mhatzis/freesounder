#!/bin/bash
# Write snapclient and control-api settings from the effective role and
# /etc/freesounder/host. Safe to run on every boot.
set -euo pipefail
effective=$(/usr/lib/freesounder/detect-role)
host_file=/etc/freesounder/host
configured=$(tr -d '[:space:]' < "$host_file" 2>/dev/null || true)
if [[ "$effective" == "host" ]]; then
	snap_host=127.0.0.1
	ma_url="http://127.0.0.1:8095"
else
	snap_host=${configured:-freesounder.local}
	ma_url="http://${snap_host}:8095"
fi

cat > /etc/default/snapclient << ENV
# Generated by freesounder. Edit /etc/freesounder/host or run freesounder-setup.
START_SNAPCLIENT=true
SNAPCLIENT_OPTS="--host ${snap_host}"
ENV

token=""
if [[ -f /etc/freesounder/ma-token ]]; then
	token=$(tr -d '[:space:]' < /etc/freesounder/ma-token)
fi

cat > /etc/freesounder/control-api.env << ENV
FREESOUNDER_HOST=0.0.0.0
FREESOUNDER_PORT=8080
FREESOUNDER_MA_URL=${ma_url}
FREESOUNDER_MA_TOKEN=${token}
FREESOUNDER_MDNS_ENABLED=true
FREESOUNDER_MDNS_NAME=$(hostname -s 2>/dev/null || echo freesounder)
FREESOUNDER_MOCK_MA=false
ENV
chmod 0640 /etc/freesounder/control-api.env
# token is a secret; restrict the token file if present
if [[ -f /etc/freesounder/ma-token ]]; then
	chmod 0600 /etc/freesounder/ma-token
fi
