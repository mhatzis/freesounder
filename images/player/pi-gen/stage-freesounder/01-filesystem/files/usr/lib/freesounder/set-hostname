#!/bin/bash
# Default static hostname is fs-new. After the player is adopted the stamp
# /etc/freesounder/hostname holds fs-<room> and this script leaves it alone.
set -euo pipefail

stamp=/etc/freesounder/hostname
name="fs-new"
if [[ -f "$stamp" ]]; then
	wanted=$(tr -d '[:space:]' < "$stamp")
	if [[ -n "$wanted" ]]; then
		name=$wanted
	fi
fi

current=$(hostname -s 2>/dev/null || true)
if [[ "$current" == "$name" ]]; then
	# Still (re)write the stamp so a later boot has it.
	install -d /etc/freesounder
	printf '%s\n' "$name" >"$stamp"
	exit 0
fi

install -d /etc/freesounder
printf '%s\n' "$name" >"$stamp"
printf '%s\n' "$name" >/etc/hostname
if command -v hostnamectl >/dev/null; then
	hostnamectl set-hostname --static "$name" || hostnamectl set-hostname "$name" || true
else
	hostname "$name" || true
fi
if command -v avahi-set-host-name >/dev/null; then
	avahi-set-host-name "$name" 2>/dev/null || true
fi
