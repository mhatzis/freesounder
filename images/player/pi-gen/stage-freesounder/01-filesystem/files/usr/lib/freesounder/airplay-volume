#!/bin/sh
# Called by shairport-sync with the sender's AirPlay volume (0..-30 dB, -144 = mute).
# Hand it to freesounderd, which maps it onto the group volume. Never blocks AirPlay.
vol=${1:-}
case "$vol" in
	''|*[!0-9.-]*) exit 0 ;;
esac
curl -fsS --max-time 2 -H 'Content-Type: application/json' \
	-X POST http://127.0.0.1:8080/api/v2/airplay/volume \
	-d "{\"airplay_db\": $vol}" >/dev/null 2>&1 &
exit 0
