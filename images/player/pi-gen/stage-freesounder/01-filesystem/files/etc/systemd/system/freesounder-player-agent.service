[Unit]
Description=freesounder player agent (adopt and room settings)
After=network-online.target freesounder-role.service
Wants=network-online.target

[Service]
Type=simple
Environment=FREESOUNDER_HOST=0.0.0.0
Environment=FREESOUNDER_AGENT_PORT=8090
Environment=FREESOUNDER_MDNS_ENABLED=true
Environment=FREESOUNDER_APPLY_COMMAND=/usr/lib/freesounder/apply-player-agent
WorkingDirectory=/opt/freesounder/player-agent
ExecStart=/opt/freesounder/control-api/.venv/bin/freesounder-player-agent
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
