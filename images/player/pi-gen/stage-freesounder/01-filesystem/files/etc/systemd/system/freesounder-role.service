[Unit]
Description=Resolve freesounder host/room role
DefaultDependencies=no
After=local-fs.target
Before=snapclient.service docker.service freesounder-music-assistant.service freesounder-control-api.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/freesounder/apply-runtime-config

[Install]
WantedBy=multi-user.target
