[Unit]
Description=Set FreeSounder appliance hostname (fs-new or fs-<room>)
DefaultDependencies=no
After=local-fs.target systemd-remount-fs.service
Before=avahi-daemon.service NetworkManager.service bluetooth.service freesounder-ble-provisioning.service freesounderd.service sysinit.target
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/freesounder/set-hostname

[Install]
WantedBy=sysinit.target multi-user.target
