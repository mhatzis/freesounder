[Unit]
Description=FreeSounder UPnP/DLNA + OpenHome renderer (upmpdcli; group leaders only, started by freesounderd)
After=network-online.target freesounder-mpd.service
Wants=network-online.target freesounder-mpd.service

[Service]
Type=simple
ExecStart=/usr/bin/upmpdcli -c /run/freesounder/upmpdcli.conf
User=upmpdcli
CacheDirectory=upmpdcli
Restart=on-failure
RestartSec=3
MemoryHigh=48M
MemoryMax=96M
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
